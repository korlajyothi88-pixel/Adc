    <!-- Departments -->
    <section id="departments">
        <h2>Our Departments</h2>

        <div class="cards">

            <div class="card">
                <h3>💻</h3>
                <p>Computer Science</p>
            </div>

            <div class="card">
                <h3>📊</h3>
                <p>Commerce</p>
            </div>

            <div class="card">
                <h3>📈</h3>
                <p>Business Administration</p>
            </div>

            <div class="card">
                <h3>🔬</h3>
                <p>Science</p>
            </div>

        </div>
    </section>

    <!-- Contact -->
    <section class="contact" id="contact">
        <h2>Contact Us</h2>

        <p><strong>College:</strong> Aditya Degree College</p>
        <p><strong>Email:</strong> info@adityadegreecollege.com</p>
